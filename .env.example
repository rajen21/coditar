# Server
PORT=4000
NODE_ENV=development

# Postgres (Prisma)
DATABASE_URL="postgresql://coditar:coditar@localhost:5434/coditar?schema=public"

# Redis (BullMQ + Socket.IO adapter)
REDIS_URL="redis://localhost:6380"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# Minio (S3-compatible, problem + testcase storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="problems"

# Kubernetes
K8S_NAMESPACE="code-exec"
# Leave unset to use default kubeconfig (~/.kube/config) with current context.
# Set to "in-cluster" when the worker itself runs inside the cluster.
K8S_MODE="kubeconfig"

# Worker
QUEUE_CONCURRENCY=3
