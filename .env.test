# Isolated env for the automated test suite - separate DB, redis db index,
# and minio bucket so tests never touch dev data (or vice versa).
PORT=4001
NODE_ENV=test

DATABASE_URL="postgresql://coditar:coditar@localhost:5434/coditar_test?schema=public"
REDIS_URL="redis://localhost:6380/2"

JWT_SECRET="test-secret"
JWT_EXPIRES_IN="1h"

MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="problems-test"

K8S_NAMESPACE="code-exec"
K8S_MODE="kubeconfig"

QUEUE_CONCURRENCY=1
